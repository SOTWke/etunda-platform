{
  "name": "etunda-platform",
  "version": "1.0.0",
  "description": "eTunda – Connecting Farmers to Markets. A scalable agricultural marketplace platform.",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @etunda/backend dev\" \"yarn workspace @etunda/frontend dev\"",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "test:watch": "yarn workspaces run test:watch",
    "lint": "yarn workspaces run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "yarn workspace @etunda/backend db:migrate",
    "db:seed": "yarn workspace @etunda/backend db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prettier": "^3.0.0"
  }
}
