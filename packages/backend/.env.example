NODE_ENV=development
PORT=5000

# Prefer DATABASE_URL for Neon / Railway / Render
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Or discrete vars (local Docker Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=etunda_db

# SSL: required for Neon. Set DB_SSL=false only for local non-SSL Postgres
# DB_SSL=true

JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Optional Stripe
# STRIPE_SECRET_KEY=
