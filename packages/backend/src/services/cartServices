import { query } from '../config/database';
import { CartItem } from '../models';
import * as productService from './productService';

export const getCartByBuyer = async (buyerId: string): Promise<any[]> => {
  const result = await query(
    `SELECT ci.*, p.name, p.price, p.quantity AS stock, p.unit,
            p.minimum_order_quantity, p.images, p.farmer_id
     FROM cart_items ci
     JOIN products p ON p.id = ci.product_id
     WHERE ci.buyer_id = $1
     ORDER BY ci.added_at DESC`,
    [buyerId]
  );
  return result.rows;
};

export const addToCart = async (
  buyerId: string,
  productId: string,
  quantity: number
): Promise<CartItem> => {
  if (quantity <= 0) {
    throw new Error('Quantity must be greater than 0');
  }

  const product = await productService.getProductById(productId);

  if (product.quantity < quantity) {
    throw new Error(
      'Insufficient stock. Available: ' + product.quantity + ', Requested: ' + quantity
    );
  }

  const moq = product.minimum_order_quantity || 1;
  if (quantity < moq) {
    throw new Error('Quantity must be at least the minimum order quantity (' + moq + ')');
  }

  const existing = await query(
    'SELECT * FROM cart_items WHERE buyer_id = $1 AND product_id = $2',
    [buyerId, productId]
  );

  if (existing.rows.length > 0) {
    const newQty = existing.rows[0].quantity + quantity;
    if (product.quantity < newQty) {
      throw new Error(
        'Insufficient stock. Available: ' + product.quantity + ', Requested total: ' + newQty
      );
    }
    const updated = await query(
      `UPDATE cart_items
       SET quantity = $1, added_at = CURRENT_TIMESTAMP
       WHERE buyer_id = $2 AND product_id = $3
       RETURNING *`,
      [newQty, buyerId, productId]
    );
    return updated.rows[0];
  }

  const result = await query(
    `INSERT INTO cart_items (buyer_id, product_id, quantity)
     VALUES ($1, $2, $3)
     RETURNING *`,
    [buyerId, productId, quantity]
  );
  return result.rows[0];
};

export const updateCartItem = async (
  buyerId: string,
  productId: string,
  quantity: number
): Promise<CartItem> => {
  if (quantity <= 0) {
    throw new Error('Quantity must be greater than 0. Use remove to delete the item.');
  }

  const product = await productService.getProductById(productId);

  if (product.quantity < quantity) {
    throw new Error(
      'Insufficient stock. Available: ' + product.quantity + ', Requested: ' + quantity
    );
  }

  const moq = product.minimum_order_quantity || 1;
  if (quantity < moq) {
    throw new Error('Quantity must be at least the minimum order quantity (' + moq + ')');
  }

  const result = await query(
    `UPDATE cart_items
     SET quantity = $1, added_at = CURRENT_TIMESTAMP
     WHERE buyer_id = $2 AND product_id = $3
     RETURNING *`,
    [quantity, buyerId, productId]
  );

  if (result.rows.length === 0) {
    throw new Error('Cart item not found');
  }

  return result.rows[0];
};

export const removeFromCart = async (buyerId: string, productId: string): Promise<void> => {
  const result = await query(
    'DELETE FROM cart_items WHERE buyer_id = $1 AND product_id = $2',
    [buyerId, productId]
  );

  if (result.rowCount === 0) {
    throw new Error('Cart item not found');
  }
};

export const clearCart = async (buyerId: string): Promise<void> => {
  await query('DELETE FROM cart_items WHERE buyer_id = $1', [buyerId]);
};

export const getCartSubtotal = async (buyerId: string): Promise<number> => {
  const result = await query(
    `SELECT COALESCE(SUM(ci.quantity * p.price), 0) AS subtotal
     FROM cart_items ci
     JOIN products p ON p.id = ci.product_id
     WHERE ci.buyer_id = $1`,
    [buyerId]
  );
  return Number(result.rows[0].subtotal);
};
