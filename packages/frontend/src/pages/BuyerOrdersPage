import { useEffect, useState } from 'react';
import Layout from '../components/Layout';
import apiClient from '../services/api';

export default function BuyerOrdersPage() {
  const [orders, setOrders] = useState<any[]>([]);
  const [error, setError] = useState('');

  useEffect(() => {
    apiClient
      .getMyOrders()
      .then((res) => setOrders(res.data || []))
      .catch((e) => setError(e.response?.data?.error || 'Failed to load orders'));
  }, []);

  return (
    <Layout>
      <h1>My Orders</h1>
      {error && <p style={{ color: 'crimson' }}>{error}</p>}
      {orders.length === 0 && !error && <p>No orders yet.</p>}
      <ul style={{ listStyle: 'none', padding: 0 }}>
        {orders.map((o) => (
          <li key={o.id} style={{ borderBottom: '1px solid #eee', padding: '12px 0' }}>
            <div>
              <strong>#{o.id.slice(0, 8)}</strong> — {o.status}
            </div>
            <div>Total: {o.total_price}</div>
            <div style={{ fontSize: 12, color: '#6b7280' }}>{new Date(o.created_at).toLocaleString()}</div>
          </li>
        ))}
      </ul>
    </Layout>
  );
}
